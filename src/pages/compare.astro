---
import "../styles/global.css";
import { HeroA } from "../components/sections/HeroA";
import { HeroB } from "../components/sections/HeroB";
import { HeroC } from "../components/sections/HeroC";
import { HeroD } from "../components/sections/HeroD";
import { HeroE } from "../components/sections/HeroE";
import { HeroF } from "../components/sections/HeroF";
import { HeroG } from "../components/sections/HeroG";
import { HeroH } from "../components/sections/HeroH";
import { HeroI } from "../components/sections/HeroI";
import { HeroJ } from "../components/sections/HeroJ";

const concepts = [
  { id: "a", label: "A — Giselle Arcs",        sub: "Concentric arcs, 3-layer spring parallax" },
  { id: "b", label: "B — Orbital Tilt",         sub: "3D perspective tilt, live orbiting nodes" },
  { id: "c", label: "C — Depth Type",           sub: "Per-word z-depth spring parallax" },
  { id: "d", label: "D — Magnetic Type",        sub: "Per-letter repel physics, ripple rings" },
  { id: "e", label: "E — Sparse Grid",          sub: "Grid draw-in, cursor spotlight" },
  { id: "f", label: "F — Musica Viva",          sub: "Concentric circles, scroll parallax on ring layer" },
  { id: "g", label: "G — Character Dissolve",   sub: "Blur+opacity dissolve per character, scan bands" },
  { id: "h", label: "H — Swiss Planes",         sub: "Hard colour boundary, straddle type, scroll peel" },
  { id: "i", label: "I — Diagonal Torsion",     sub: "Vertical rules shear to diagonal on scroll" },
  { id: "j", label: "J — Growing Arc",          sub: "Arc expands from fragment → full sweep on scroll" },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hero Concepts — Compare</title>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)] antialiased">
    <div class="noise-overlay"></div>

    <!-- Fixed concept navigator -->
    <nav class="fixed top-5 right-5 z-50 flex flex-col gap-1" aria-label="Jump to concept">
      {concepts.map((c) => (
        <a
          href={`#hero-${c.id}`}
          class="flex items-center justify-center w-7 h-7 text-[8px] uppercase tracking-[0.2em] text-[var(--color-muted)] hover:text-[var(--color-text)] border border-[rgba(216,207,196,0.1)] hover:border-[rgba(216,207,196,0.28)] bg-[var(--color-bg)] transition-colors duration-150"
          style="font-family: var(--font-mono)"
        >
          {c.id.toUpperCase()}
        </a>
      ))}
    </nav>

    <main>

      <div id="hero-a" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">A</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Giselle Arcs</span>
          <span class="text-[11px] text-[var(--color-muted)]">Concentric arcs, 3-layer spring parallax</span>
        </div>
        <HeroA client:visible />
      </div>

      <div id="hero-b" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">B</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Orbital Tilt</span>
          <span class="text-[11px] text-[var(--color-muted)]">3D perspective tilt, live orbiting nodes</span>
        </div>
        <HeroB client:visible />
      </div>

      <div id="hero-c" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">C</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Depth Type</span>
          <span class="text-[11px] text-[var(--color-muted)]">Per-word z-depth spring parallax</span>
        </div>
        <HeroC client:visible />
      </div>

      <div id="hero-d" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">D</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Magnetic Type</span>
          <span class="text-[11px] text-[var(--color-muted)]">Per-letter repel physics, ripple rings</span>
        </div>
        <HeroD client:visible />
      </div>

      <div id="hero-e" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">E</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Sparse Grid</span>
          <span class="text-[11px] text-[var(--color-muted)]">Grid draw-in, cursor spotlight, cell hover</span>
        </div>
        <HeroE client:visible />
      </div>

      <div id="hero-f" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">F</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Musica Viva</span>
          <span class="text-[11px] text-[var(--color-muted)]">Slow concentric circles, scroll parallax on ring layer</span>
        </div>
        <HeroF client:visible />
      </div>

      <div id="hero-g" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">G</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Character Dissolve</span>
          <span class="text-[11px] text-[var(--color-muted)]">Per-character blur dissolve, scan bands, scroll parallax</span>
        </div>
        <HeroG client:visible />
      </div>

      <div id="hero-h" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">H</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Swiss Planes</span>
          <span class="text-[11px] text-[var(--color-muted)]">Hard colour split, straddle type, panel peels on scroll</span>
        </div>
        <HeroH client:visible />
      </div>

      <div id="hero-i" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">I</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Diagonal Torsion</span>
          <span class="text-[11px] text-[var(--color-muted)]">Vertical rules shear to diagonal as you scroll</span>
        </div>
        <HeroI client:visible />
      </div>

      <div id="hero-j" class="scroll-mt-0">
        <div class="border-y border-[rgba(216,207,196,0.08)] px-8 py-2 flex items-center gap-4 bg-[rgba(255,255,255,0.01)]">
          <span class="text-[8px] uppercase tracking-[0.34em] text-[rgba(216,207,196,0.28)]" style="font-family:var(--font-mono)">J</span>
          <span class="text-[9.5px] uppercase tracking-[0.22em] text-[var(--color-text)]" style="font-family:var(--font-mono)">Growing Arc</span>
          <span class="text-[11px] text-[var(--color-muted)]">Arc expands from small fragment to full sweep on scroll</span>
        </div>
        <HeroJ client:visible />
      </div>

    </main>
  </body>
</html>
