---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { HeroField } from "../components/sections/HeroField";
import { OutputSection } from "../components/sections/Output";
import { AboutSection } from "../components/sections/About";
import { ContactSection } from "../components/sections/Contact";
---

<BaseLayout>
  <Header />
  <!-- dissolve-host applies the cursor displacement filter; it sits *below*
       the sticky Header so the header's position: sticky isn't broken by the
       CSS filter creating a containing block. -->
  <div class="dissolve-host">
    <main>
      <HeroField client:load />
      <OutputSection client:visible />
      <AboutSection client:visible />
      <ContactSection client:visible />
    </main>
    <Footer />
  </div>
</BaseLayout>
